# Copy this file to  plash.env  and set a long, unique password.
# plash.env is uploaded by plash-deploy and loaded as environment variables on Plash.
# main.py also reads it for local runs (real environment variables take precedence).
# Do NOT commit plash.env to git.
export FLOWKB_PASSWORD='change-me-to-a-long-random-passphrase'
# Optional: fixed session-signing secret (otherwise data/.sesskey is generated and kept in data/)
# export FLOWKB_SESSION_SECRET='another-long-random-string'
